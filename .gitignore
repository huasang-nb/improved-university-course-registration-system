# 编译产物
build/
*.exe
*.o
*.obj

# 编辑器与本机配置
.vs/
.vscode/
*.user

# Python 缓存（生成图的脚本）
__pycache__/
*.pyc

# 本地 HTTP 联调与测试运行时目录（不入库）
http-dev-runtime/
http-test-runtime/
data/http-dev-state.json
# 本地运行状态及其临时文件、备份（示例 JSON 请使用单独文件名）
/data/state.json
/data/state.json.tmp
/data/state.json.bak
/data/*.password.lock
